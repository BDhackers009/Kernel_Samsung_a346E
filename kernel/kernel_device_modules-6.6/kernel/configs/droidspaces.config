# DroidSpaces kernel options — GKI-safe set
# https://github.com/ravindu644/Droidspaces-OSS
#
# Enabled with the "droidspaces" checkbox in the Build A346E workflow
# (DROIDSPACES=true). Merged after gki_defconfig and mediatek-bazel_defconfig,
# so it wins over Samsung's defaults.
#
# ABI note: this tree is GKI-based and the phone keeps Samsung's stock modules
# (AnyKernel3 uses do.modules=0), so module compatibility is enforced by symbol
# CRCs. CONFIG_SYSVIPC adds sysvsem/sysvshm to struct task_struct by value; that
# is handled by kernel/patches-kernel-6.6/0005-GKI-below-fix_sysvipc_kabi.patch,
# which moves them into the Android KABI padding (slots 3/4/5, free in this
# tree). Do not add options that resize scheduler or cgroup structures, see the
# end of this file.

# --- IPC ---
# SYSVIPC needs CONFIG_SYSCTL, which this tree already sets.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Namespaces (IPC_NS depends on SYSVIPC || POSIX_MQUEUE) ---
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# --- Hardware access inside containers ---
CONFIG_DEVTMPFS=y

# --- Networking: NAT mode ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Optional but recommended by DroidSpaces ---
# User namespaces: Docker, sandboxing. Widens the kernel attack surface; SELinux
# still confines it. Remove this line if you do not want it.
CONFIG_USER_NS=y

# IPv6 NAT (NAT66)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# macvlan mode (--net=macvlan): a container straight on the LAN
CONFIG_MACVLAN=y

# UFW / Fail2ban inside containers
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# NixOS support: xattr and POSIX ACL on tmpfs
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ---------------------------------------------------------------------------
# Deliberately NOT enabled (kept as documentation, do not uncomment):
#
# CONFIG_CFS_BANDWIDTH=y   --cpus limit. Resizes struct cfs_rq/sched_entity,
#                          changes the CRC of thousands of exported symbols and
#                          no KABI padding covers it. Stock Samsung modules
#                          would refuse to load -> bootloop.
# CONFIG_CGROUP_PIDS=y     --pids-limit. Same class of ABI break.
#
# Enabling either requires rebuilding *every* module on the device from this
# tree and flashing vendor_boot, vendor_dlkm and system_dlkm with boot.img.
# Everything else DroidSpaces needs works without them.
#
# CONFIG_MEMCG_SWAP        Removed upstream in 6.1; cgroup v2 memory.swap.max
#                          covers it on 6.6, nothing to set.
# ---------------------------------------------------------------------------
